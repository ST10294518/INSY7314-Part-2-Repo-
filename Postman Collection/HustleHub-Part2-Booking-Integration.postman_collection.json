    {
      "name": "Exactly one matching Transaction",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ownerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/transactions/mine"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const transactions = pm.response.json().transactions;",
              "pm.test('Retry created no duplicate Transaction', () => pm.expect(transactions).to.have.lengthOf(1));",
              "pm.test('Correct Transaction ID', () => pm.expect(transactions[0]._id).to.eql(pm.variables.get('transactionId')));",
              "pm.test('Populated Booking matches', () => pm.expect(transactions[0].booking._id).to.eql(pm.variables.get('bookingId')));",
              "pm.test('Saved amount unchanged', () => pm.expect(transactions[0].amount).to.eql(125.50));"
            ]
          }
        }
      ]
    },
    {
      "name": "Income increases exactly once",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ownerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/transactions/income"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test('Currency is ZAR', () => pm.expect(result.currency).to.eql('ZAR'));",
              "pm.test('Income increased by 125.50', () => pm.expect(result.totalIncome).to.eql(Number(pm.variables.get('startingIncome')) + 125.50));",
              "pm.test('Count increased by one', () => pm.expect(result.completedTransactions).to.eql(Number(pm.variables.get('startingCount')) + 1));"
            ]
          }
        }
      ]
