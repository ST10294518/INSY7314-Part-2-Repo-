    {
      "name": "Starting Freelancer income",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ownerToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/transactions/income"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.variables.set('startingIncome', result.totalIncome);",
              "pm.variables.set('startingCount', result.completedTransactions);",
              "pm.test('New account starts at zero', () => pm.expect(result.totalIncome).to.eql(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "Client creates Booking and Transaction",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{clientToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{bookingKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"gigId\": \"{{gigId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const result = pm.response.json();",
              "pm.variables.set('bookingId', result.booking._id);",
              "pm.variables.set('transactionId', result.transaction._id);",
              "pm.test('Booking confirmed', () => pm.expect(result.booking.status).to.eql('confirmed'));",
              "pm.test('Transaction completed', () => pm.expect(result.transaction.status).to.eql('completed'));",
              "pm.test('Transaction links to Booking', () => pm.expect(result.transaction.booking).to.eql(result.booking._id));",
              "pm.test('Client assigned from JWT', () => pm.expect(result.booking.client).to.eql(pm.variables.get('clientId')));",
              "pm.test('Freelancer assigned from Gig', () => pm.expect(result.booking.freelancer).to.eql(pm.variables.get('ownerId')));",
              "pm.test('Booking uses saved price', () => pm.expect(result.booking.price).to.eql(125.50));",
              "pm.test('Transaction uses saved price', () => pm.expect(result.transaction.amount).to.eql(125.50));",
              "pm.test('Transaction identities match', () => { pm.expect(result.transaction.client).to.eql(result.booking.client); pm.expect(result.transaction.freelancer).to.eql(result.booking.freelancer); });",
              "pm.test('First operation is new', () => pm.expect(result.reused).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "Same-key retry reuses original records",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{clientToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{bookingKey}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"gigId\": \"{{gigId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test('Retry marked reused', () => pm.expect(result.reused).to.eql(true));",
              "pm.test('Same Booking ID', () => pm.expect(result.booking._id).to.eql(pm.variables.get('bookingId')));",
              "pm.test('Same Transaction ID', () => pm.expect(result.transaction._id).to.eql(pm.variables.get('transactionId')));"
            ]
          }
        }
      ]
    },
