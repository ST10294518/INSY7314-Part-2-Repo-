{
  "info": {
    "name": "HustleHub Part 2 - Booking and Transaction Integration",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Creates four test accounts, two Gigs and one completed Booking/Transaction. Records remain for inspection. Rate-limit testing is separate."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:5443"
    },
    {
      "key": "invalidToken",
      "value": "invalid-test-token"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.variables.get('integrationInitialised')) {",
          "  const suffix = pm.variables.replaceIn('{{$guid}}');",
          "  for (const name of ['owner', 'otherFreelancer', 'client', 'otherClient']) {",
          "    pm.variables.set(name + 'Email', 'integration-' + name.toLowerCase() + '-' + suffix + '@example.com');",
          "  }",
          "  pm.variables.set('testPassword', 'IntegrationPass9!' + suffix);",
          "  pm.variables.set('bookingKey', pm.variables.replaceIn('{{$guid}}'));",
          "  pm.variables.set('freshKey', pm.variables.replaceIn('{{$guid}}'));",
          "  pm.variables.set('integrationInitialised', true);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Register owner",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{ownerEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"freelancer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const result = pm.response.json();",
              "pm.variables.set('ownerToken', result.token);",
              "pm.variables.set('ownerId', result.user.id);",
              "pm.test('Correct role', () => pm.expect(result.user.role).to.eql('freelancer'));",
              "pm.test('Password excluded', () => pm.expect(result.user).not.to.have.property('passwordHash'));"
            ]
          }
        }
      ]
    },
