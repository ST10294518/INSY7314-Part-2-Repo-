{
  "info": {
    "name": "HustleHub Part 2 - Admin Access Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Uses an existing Admin and creates two ordinary test accounts. Admin endpoints are read-only. Credentials must be supplied privately."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:5443"
    },
    {
      "key": "invalidToken",
      "value": "invalid-test-token"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.variables.get('adminTestInitialised')) {",
          "  const suffix = pm.variables.replaceIn('{{$guid}}');",
          "  pm.variables.set('clientEmail', 'admin-test-client-' + suffix + '@example.com');",
          "  pm.variables.set('freelancerEmail', 'admin-test-freelancer-' + suffix + '@example.com');",
          "  pm.variables.set('publicAdminEmail', 'admin-test-public-' + suffix + '@example.com');",
          "  pm.variables.set('testPassword', 'AdminTestPass9!' + suffix);",
          "  pm.variables.set('adminTestInitialised', true);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Existing Admin login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const result = pm.response.json();",
              "pm.test('Admin role verified', () => pm.expect(result.user.role).to.eql('admin'));",
              "pm.variables.set('adminToken', result.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Register test client",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{clientEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"client\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.variables.set('clientToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Register test freelancer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{freelancerEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"freelancer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.variables.set('freelancerToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin accesses me",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Password fields excluded', () => pm.expect(pm.response.text()).not.to.match(/\"(?:password|passwordHash)\"\\s*:/));",
              "pm.test('Safe Admin profile', () => pm.expect(pm.response.json().user.role).to.eql('admin'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Client blocked from me",
