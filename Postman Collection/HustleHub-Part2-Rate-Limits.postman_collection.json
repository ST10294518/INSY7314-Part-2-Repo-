{
  "info": {
    "name": "HustleHub Part 2 - Endpoint Rate Limits",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run once against a freshly started local backend with no concurrent requests. Creates one test Client; creates no Gigs, Bookings or Transactions."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:5443"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.variables.get('rateInitialised')) {",
          "  const suffix = pm.variables.replaceIn('{{$guid}}');",
          "  pm.variables.set('rateEmail', 'rate-client-' + suffix + '@example.com');",
          "  pm.variables.set('ratePassword', 'RateTestPass9!' + suffix);",
          "  pm.variables.set('rateInitialised', true);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Registration 1: create rate-test Client",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{rateEmail}}\",\n  \"password\": \"{{ratePassword}}\",\n  \"role\": \"client\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.variables.set('rateClientToken', pm.response.json().token);",
              "pm.test('Client created', () => pm.expect(pm.response.json().user.role).to.eql('client'));"
            ]
          }
        }
      ]
    },
